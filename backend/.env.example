# ============================================
# FaceFind - Environment Variables
# ============================================

# Local-only database and filesystem storage
LOCAL_ONLY=true
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=facefind

# JWT Authentication (CHANGE THIS before deploying!)
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin (CHANGE password before deploying!)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=CHANGE_ME

# Face Recognition
FACE_TOLERANCE=0.5
FACE_MODEL=hog
MAX_PROCESSING_DIM=1000

# Upload Settings
MAX_FILE_SIZE_MB=20
MAX_BULK_UPLOAD=25

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=True

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
