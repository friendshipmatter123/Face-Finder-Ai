# ============================================
# FaceFind - Environment Variables
# ============================================

# Database
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/facefind?retryWrites=true&w=majority
MONGODB_DATABASE=facefind

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# JWT Authentication (CHANGE THIS before deploying!)
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin (CHANGE password before deploying!)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=CHANGE_ME

# Face Recognition
FACE_TOLERANCE=0.5
FACE_MODEL=hog
MAX_PROCESSING_DIM=1600

# Upload Settings
MAX_FILE_SIZE_MB=20
MAX_BULK_UPLOAD=500

# Server
HOST=0.0.0.0
PORT=8001
DEBUG=True

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
